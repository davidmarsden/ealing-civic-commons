{
  "name": "ealing-civic-commons-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "validate:contributions": "node scripts/validate-contributions.mjs",
    "validate:evidence": "node scripts/validate-evidence.mjs",
    "inspect:ealing-data": "node scripts/ealing-data-catalog.mjs",
    "render:social-cards": "node scripts/render-social-cards.mjs",
    "verify:social-cards": "node scripts/verify-social-cards.mjs",
    "build": "npm run validate:contributions && npm run validate:evidence && mkdir -p dist/documents/content && cp -R public/. dist/ && cp docs/*.md dist/documents/content/ && npm run render:social-cards && npm run verify:social-cards"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.1",
    "fast-xml-parser": "^5.2.5",
    "sharp": "^0.34.4"
  }
}
