/assets/*
  Cache-Control: public, max-age=31536000, immutable

/site-shell.js
  Cache-Control: public, max-age=0, must-revalidate

/entity.js
  Cache-Control: public, max-age=0, must-revalidate

/issue.js
  Cache-Control: public, max-age=0, must-revalidate

/entity.html
  Cache-Control: public, max-age=0, must-revalidate

/issue.html
  Cache-Control: public, max-age=0, must-revalidate

/entity-dossier-ui.js
  Cache-Control: public, max-age=0, must-revalidate

/issue-planning-ui.js
  Cache-Control: public, max-age=0, must-revalidate

/section-nav-sync.js
  Cache-Control: public, max-age=0, must-revalidate

/dossier-cards.css
  Cache-Control: public, max-age=0, must-revalidate

/places/*
  Cache-Control: public, max-age=0, must-revalidate

/issues/*
  Cache-Control: public, max-age=0, must-revalidate

/data/planning-latest.json
  Cache-Control: public, max-age=0, must-revalidate

/data/planning-archive.json
  Cache-Control: public, max-age=0, must-revalidate

# SocialSpec (socialspec.org): AboutSpec and ContactSpec. FollowSpec
# (/.well-known/following.opml) is served by the socialspec-following function.
/.well-known/about.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/.well-known/contact.vcf
  Content-Type: text/vcard; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
