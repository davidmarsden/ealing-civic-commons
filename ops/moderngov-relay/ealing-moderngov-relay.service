[Unit]
Description=Ealing Civic Commons ModernGov RSS relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/opt/ealing-moderngov-relay
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8788
ExecStart=/usr/bin/node /opt/ealing-moderngov-relay/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
